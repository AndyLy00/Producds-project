<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's quick-add window (QuickAddActivity), in the app's colors. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/quick_add_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#203f2b"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/quick_add_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/quick_add_field"
        android:hint="@string/quick_add_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:maxLength="500"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#203f2b"
        android:textColorHint="#858675"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/quick_add_note"
        android:textColor="#858675"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/quick_add_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_add_cancel"
            android:textAllCaps="false"
            android:textColor="#2f603c" />

        <Button
            android:id="@+id/quick_add_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/quick_add_button"
            android:minWidth="110dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/quick_add_button"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
